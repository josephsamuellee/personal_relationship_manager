<div class="config-page">
  <h1>Config</h1>

  <section class="config-section">
    <h2>Appearance</h2>
    <div class="theme-control">
      <span>Theme: <%= @theme.capitalize %></span>
      <%= form_with url: config_path, method: :patch, class: "theme-toggle-form" do %>
        <%= hidden_field_tag :theme, @theme == "dark" ? "light" : "dark" %>
        <%= button_tag type: "submit", class: "theme-toggle #{@theme}", role: "switch", "aria-checked": (@theme == "dark").to_s, "aria-label": "Switch theme" do %>
          <span class="theme-toggle-track">
            <span class="theme-toggle-knob"></span>
          </span>
        <% end %>
      <% end %>
    </div>
  </section>

  <section class="config-section">
    <h2>Google Calendar</h2>
    <% case @google_status %>
    <% when :not_configured %>
      <p><strong>Status:</strong> Not configured</p>
      <p>
        Client ID and secret are missing from the environment.
        Follow the steps below, then reload this page to connect.
      </p>
      <%= render "config/google_calendar_setup" %>
    <% when :disconnected %>
      <p><strong>Status:</strong> Disconnected</p>
      <p>
        OAuth client credentials are present. Connect your Google account next,
        then choose which calendars appear on Upcoming Calendar.
      </p>
      <p><%= link_to "Connect Google Calendar", google_calendar_oauth_connect_path, class: "button-primary" %></p>
      <details class="google-calendar-setup-details">
        <summary>Show setup reference (redirect URI and env vars)</summary>
        <%= render "config/google_calendar_setup" %>
      </details>
    <% when :reconnect_required %>
      <p><strong>Status:</strong> Reconnect required</p>
      <p>Stored Google authorization can no longer be used. Reconnect, or disconnect and start over.</p>
      <p><%= link_to "Reconnect Google Calendar", google_calendar_oauth_connect_path, class: "button-primary" %></p>
      <p>
        <%= button_to "Disconnect", google_calendar_oauth_disconnect_path, method: :delete, class: "button-secondary" %>
      </p>
      <details class="google-calendar-setup-details">
        <summary>Show setup reference (redirect URI and env vars)</summary>
        <%= render "config/google_calendar_setup" %>
      </details>
    <% when :connected %>
      <p><strong>Status:</strong> Connected</p>
      <p>
        <%= button_to "Disconnect", google_calendar_oauth_disconnect_path, method: :delete, class: "button-secondary" %>
      </p>
      <%= form_with url: config_path, method: :patch, class: "google-calendar-allowlist-form" do %>
        <%= hidden_field_tag :google_calendar_allowlist_form, "1" %>
        <fieldset>
          <legend>Calendars for Upcoming Calendar</legend>
          <% if @google_calendars.empty? %>
            <p class="placeholder">No calendars were returned from Google.</p>
          <% else %>
            <ul class="calendar-allowlist">
              <% @google_calendars.each do |calendar| %>
                <li>
                  <label>
                    <%= check_box_tag "google_calendar_ids[]", calendar.id, @google_allowlist.include?(calendar.id), id: "google_calendar_#{calendar.id}" %>
                    <%= calendar.summary %><%= " (primary)" if calendar.primary %>
                  </label>
                </li>
              <% end %>
            </ul>
          <% end %>
        </fieldset>
        <%= submit_tag "Save calendar selection", class: "button-primary" %>
      <% end %>
    <% end %>
  </section>

  <section class="config-section">
    <h2>Favorite People</h2>
    <p class="placeholder"><em>Favorite People homepage slots (positions 1, 2, and 3) are set on each Person page using the Favorite People dropdown, then saved with that page. They cannot be edited here.</em></p>
  </section>

  <section class="config-section">
    <h2>Database</h2>
    <table class="stats-table">
      <tbody>
        <tr>
          <th scope="row">Size</th>
          <td><%= @statistics.formatted_database_size %></td>
        </tr>
        <tr>
          <th scope="row">Total entries</th>
          <td><%= @statistics.total_entries %></td>
        </tr>
        <tr>
          <th scope="row">Created last 30 days</th>
          <td><%= @statistics.entries_created_last_30_days %></td>
        </tr>
      </tbody>
    </table>
  </section>
</div>
