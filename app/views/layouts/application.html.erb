<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Personal Relationship Manager" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="app-body" data-controller="nav-debug" data-draft-in-session="<%= entry_draft_in_session? %>">
    <% if flash[:notice] %>
      <div class="flash flash-notice"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert] %>
      <div class="flash flash-alert"><%= flash[:alert] %></div>
    <% end %>

    <main class="main-content">
      <%= yield %>
    </main>

    <%= render "shared/floating_controls" %>
  </body>
</html>
