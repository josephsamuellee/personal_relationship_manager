<% save_success_banner = flash[:notice] == "Entry saved." %>
<!DOCTYPE html>
<html data-theme="<%= current_theme %>">
  <head>
    <title><%= content_for(:title) || "Personal Relationship Manager" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="app-body<%= " has-save-banner" if save_success_banner %>">
    <% if flash[:notice] %>
      <%= tag.div class: ["flash", "flash-notice", ("flash-save-success" if save_success_banner)],
            data: (save_success_banner ? { controller: "save-banner" } : {}) do %>
        <%= flash[:notice] %>
      <% end %>
    <% end %>
    <% if flash[:alert] %>
      <div class="flash flash-alert"><%= flash[:alert] %></div>
    <% end %>

    <main class="main-content">
      <%= yield %>
    </main>

    <%= render "shared/floating_controls" %>
  </body>
</html>
