<h1>Entries matching "<%= @query %>"</h1>

<%= form_with url: search_path, method: :get, class: "search-page-form" do %>
  <%= text_field_tag :q, @query, placeholder: "Search..." %>
  <%= submit_tag "Search" %>
<% end %>

<% if @entries.any? %>
  <table class="search-entries-table">
    <thead>
      <tr>
        <th>Entry</th>
        <th>Date</th>
        <th>People</th>
      </tr>
    </thead>
    <tbody>
      <% @entries.each do |entry| %>
        <tr>
          <td><%= link_to entry.title, entry_path(entry) %></td>
          <td><%= entry.occurred_on %></td>
          <td>
            <%= safe_join(
                  entry.people_in_display_order.map { |person| link_to(person.name, person_path(person)) },
                  ", "
                ) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No entries found matching "<%= @query %>".</p>
<% end %>
