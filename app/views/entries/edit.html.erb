<h1>Edit Entry</h1>

<%= form_with url: preview_entry_path(@entry), method: :post, class: "entry-form" do |form| %>
  <%= hidden_field_tag "entry[entry_id]", @entry.id %>

  <div class="field">
    <%= label_tag :entry_title, "Title" %>
    <%= text_field_tag "entry[title]", @draft.title, required: true %>
  </div>

  <%= render "entries/occurred_on_field", raw_date: @draft.raw_date %>

  <%= render "shared/markdown_editor_field",
             name: "entry[body_markdown]",
             value: @draft.body_markdown,
             label: "Markdown Body",
             label_for: "entry_body_markdown",
             rows: 12,
             required: true %>

  <%= submit_tag "Preview" %>
<% end %>
