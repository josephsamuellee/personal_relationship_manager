<h1>Edit Entry</h1>

<% if @draft&.validation_errors&.any? %>
  <div class="flash flash-alert" role="alert">
    <ul>
      <% @draft.validation_errors.each do |error| %>
        <li><%= error %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with url: entry_path(@entry), method: :patch, class: "entry-form" do |form| %>
  <%= hidden_field_tag "entry[entry_id]", @entry.id %>

  <div class="field">
    <%= label_tag :entry_title, "Title" %>
    <%= text_field_tag "entry[title]", @draft.title, required: true %>
  </div>

  <%= render "entries/occurred_on_field", raw_date: @draft.raw_date %>

  <%= render "shared/markdown_editor_field",
             name: "entry[body_markdown]",
             value: @draft.body_markdown,
             label: "Markdown Body",
             label_for: "entry_body_markdown",
             rows: 12,
             required: true %>

  <%= submit_tag "Save", data: { turbo_submits_with: "Saving..." } %>
<% end %>
