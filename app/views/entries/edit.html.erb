<h1>Edit Entry</h1>

<% if @entry_changed_warning %>
  <div class="flash flash-alert" role="alert">
    <p>This committed Entry changed after this draft was started. Saving will overwrite the Entry with this draft.</p>
  </div>
<% end %>

<% if @draft&.validation_errors&.any? %>
  <div class="flash flash-alert" role="alert">
    <ul>
      <% @draft.validation_errors.each do |error| %>
        <li><%= error %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with url: entry_path(@entry),
              method: :patch,
              class: "entry-form",
              data: {
                controller: "recent-people entry-draft-autosave",
                recent_people_markdown_editor_outlet: ".markdown-editor-field",
                entry_draft_autosave_create_url_value: entry_drafts_path,
                entry_draft_autosave_update_url_template_value: "/entry_drafts/:id",
                entry_draft_autosave_edit_url_template_value: "/entry_drafts/:id/edit",
                entry_draft_autosave_draft_id_value: @draft.persistent_draft_id.to_i,
                entry_draft_autosave_entry_id_value: @entry.id,
                entry_draft_autosave_lock_version_value: (@persistent_draft&.lock_version || 0),
                entry_draft_autosave_client_create_id_value: (@persistent_draft&.client_create_id || "")
              } do |form| %>
  <%= hidden_field_tag "entry[entry_id]", @entry.id %>
  <% if @draft.persistent_draft_id.present? %>
    <%= hidden_field_tag "entry[draft_id]", @draft.persistent_draft_id %>
  <% end %>
  <% if @persistent_draft %>
    <%= hidden_field_tag "entry[lock_version]", @persistent_draft.lock_version, data: { entry_draft_autosave_target: "lockVersion" } %>
  <% else %>
    <%= hidden_field_tag "entry[lock_version]", "0", data: { entry_draft_autosave_target: "lockVersion" } %>
  <% end %>

  <div class="field">
    <%= label_tag :entry_title, "Title" %>
    <%= text_field_tag "entry[title]", @draft.title, required: true %>
  </div>

  <%= render "entries/occurred_on_field", raw_date: @draft.raw_date %>

  <%= render "shared/markdown_editor_field",
             name: "entry[body_markdown]",
             value: @draft.body_markdown,
             label: "Markdown Body",
             label_for: "entry_body_markdown",
             rows: 12,
             required: true %>

  <p class="draft-autosave-status hint"
     data-entry-draft-autosave-target="status"
     aria-live="polite"></p>

  <%= render "entries/draft_conflict_panel" %>

  <%= submit_tag "Save", data: { turbo_submits_with: "Saving..." } %>

  <%= render "entries/recent_people", people: @recent_people %>
<% end %>
