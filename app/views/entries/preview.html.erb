<h1><%= @entry ? "Edit Entry" : "Preview Entry" %></h1>

<div class="preview-status <%= @draft.valid_for_save? ? 'preview-status-ready' : 'preview-status-needs-attention' %>">
  <% if @draft.valid_for_save? %>
    <p><strong>Ready to save.</strong> All <%= pluralize(@draft.parsed_people.size, "person") %> resolved. Your draft is stored — click Save below to publish.</p>
  <% else %>
    <p><strong>Needs attention before saving.</strong> Your draft is stored — resolve the items below, then click Save.</p>
    <ul class="preview-status-list">
      <% @draft.validation_errors.each do |error| %>
        <li><%= error %></li>
      <% end %>
      <% if @draft.unresolved_people.any? %>
        <li><%= pluralize(@draft.unresolved_people.size, "person") %> to resolve: <%= @draft.unresolved_people.map { |item| item[:name] }.join(", ") %></li>
      <% end %>
    </ul>
  <% end %>
</div>

<% @draft.unresolved_people.each do |item| %>
  <div class="resolution-panel">
    <% if item[:result].unknown? %>
      <p>No person named "<%= item[:name] %>" exists.</p>
      <% if item[:suggestions].any? %>
        <p><strong>Did you mean:</strong></p>
        <ul class="resolution-options">
          <% item[:suggestions].each do |person| %>
            <li>
              <%= button_to "Replace \"#{item[:name]}\" with \"#{person.name}\"", replace_person_name_entries_path, method: :post, params: { name: item[:name], replacement: person.name }, form: { data: { turbo: false } } %>
            </li>
          <% end %>
        </ul>
      <% end %>
      <%= button_to "Create #{item[:name]}", create_person_entries_path, method: :post, params: { name: item[:name] }, form: { data: { turbo: false } } %>
    <% elsif item[:result].ambiguous? %>
      <p>"<%= item[:name] %>" matches multiple people. Pick one:</p>
      <ul class="resolution-options">
        <% item[:result].people.each do |person| %>
          <li>
            <%= button_to person.name, resolve_person_entries_path, method: :post, params: { name: item[:name], person_id: person.id }, form: { data: { turbo: false } } %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
<% end %>

<div class="preview-card">
  <p><strong>Title:</strong> <%= @draft.title %></p>
  <p><strong>Date:</strong> <%= @draft.occurred_on %></p>
  <p><strong>Primary:</strong> <%= @draft.primary_person&.name || "—" %></p>
  <p><strong>Referenced:</strong> <%= @draft.secondary_people.map(&:name).presence&.join(", ") || "—" %></p>
  <p><strong>Tags:</strong> <%= @draft.parsed_tags.presence&.join(", ") || "—" %></p>

  <% if @entry && @relationship_diff&.changed? %>
    <div class="relationship-diff">
      <h3>Relationship Changes</h3>
      <% diff = @relationship_diff.changes %>
      <% if diff.primary_from != diff.primary_to %>
        <p>Primary: <%= diff.primary_from %> → <%= diff.primary_to %></p>
      <% end %>
      <% if diff.removed.any? %>
        <p>Removed references:</p>
        <ul><% diff.removed.each { |name| %><li>- <%= name %></li><% } %></ul>
      <% end %>
      <% if diff.added.any? %>
        <p>Added references:</p>
        <ul><% diff.added.each { |name| %><li>+ <%= name %></li><% } %></ul>
      <% end %>
    </div>
  <% end %>

  <div class="preview-markdown">
    <h3>Rendered preview</h3>
    <%= render_markdown(@draft.body_markdown) %>
  </div>
</div>

<div class="preview-actions">
  <% if @draft.valid_for_save? %>
    <% if @entry %>
      <%= button_to "Save entry", entry_path(@entry), method: :patch, class: "button-primary", form: { data: { turbo: false } } %>
    <% else %>
      <%= button_to "Save entry", entries_path, method: :post, class: "button-primary", form: { data: { turbo: false } } %>
    <% end %>
  <% else %>
    <p class="hint">Save will be available once all people are resolved and validation passes.</p>
  <% end %>

  <%= link_to "Edit entry", @entry ? edit_entry_path(@entry) : new_entry_path, class: "button-secondary" %>
  <%= button_to "Discard draft", discard_draft_entries_path, method: :delete, class: "button-danger", form: { data: { turbo: false, turbo_confirm: "Discard this draft?" } } %>
</div>
