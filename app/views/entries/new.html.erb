<h1>New Entry</h1>

<%= form_with url: preview_entries_path, method: :post, class: "entry-form" do |form| %>
  <div class="field">
    <%= label_tag :entry_title, "Title" %>
    <%= text_field_tag "entry[title]",
                       @draft.title,
                       required: true,
                       data: (@autofocus_title ? { controller: "autofocus" } : {}) %>
  </div>

  <%= render "entries/occurred_on_field", raw_date: @draft.raw_date %>

  <div class="field">
    <%= label_tag :entry_body_markdown, "Markdown Body" %>
    <%= text_area_tag "entry[body_markdown]", @draft.body_markdown, rows: 12, required: true %>
    <p class="hint">Use [[Person Name]] for people and #tag for tags.</p>
  </div>

  <%= submit_tag "Preview" %>
<% end %>
