<h1>New Entry</h1>

<%= form_with url: preview_entries_path, method: :post, class: "entry-form" do |form| %>
  <div class="field">
    <%= label_tag :entry_title, "Title" %>
    <%= text_field_tag "entry[title]",
                       @draft.title,
                       required: true,
                       data: (@autofocus_title ? { controller: "autofocus" } : {}) %>
  </div>

  <%= render "entries/occurred_on_field", raw_date: @draft.raw_date %>

  <%= render "shared/markdown_editor_field",
             name: "entry[body_markdown]",
             value: @draft.body_markdown,
             label: "Markdown Body",
             label_for: "entry_body_markdown",
             rows: 12,
             required: true,
             hint: "Use [[Person Name]] for people and #tag for tags." %>

  <%= submit_tag "Preview" %>
<% end %>
