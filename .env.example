APP_TIME_ZONE=America/Los_Angeles
DATABASE_PATH=storage/production.sqlite3
SECRET_KEY_BASE=change-me-in-production

# Google Calendar (Upcoming Calendar) — read-only OAuth
# Register an OAuth Web client in Google Cloud Console with redirect URI:
#   https://<your-cloudflare-tunnel-host>/google_calendar/oauth/callback
#   http://localhost:3000/google_calendar/oauth/callback  (development)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Encrypted token file path (outside git). Default: storage/google_calendar_tokens.json.enc
GOOGLE_CALENDAR_TOKEN_PATH=

# Obsolete: iframe embed is no longer used by Upcoming Calendar
# GOOGLE_CALENDAR_EMBED_URL=
